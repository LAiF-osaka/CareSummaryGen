# ============================================================
# 環境切替（ここだけ変更すれば OK）
#   production: ローカル Ollama（閉域ネットワーク）
#   test      : Ollama Cloud（インターネット経由、要 ollama signin）
# ============================================================
ENV=production

# === 本番環境（ローカル Ollama）===
OLLAMA_MODEL_PRODUCTION=gpt-oss:120b
OLLAMA_BASE_URL_PRODUCTION=http://localhost:11434

# === テスト環境（Ollama Cloud）===
OLLAMA_MODEL_TEST=gpt-oss:120b-cloud
OLLAMA_BASE_URL_TEST=https://ollama.com
# Ollama Cloud 利用時の API キー（ollama.com/settings/keys で取得）
# OLLAMA_API_KEY=your-api-key-here

# 補足:
#   - 環境別変数 (OLLAMA_MODEL_TEST 等) が最優先で解決される
#   - 共通変数 (OLLAMA_MODEL / OLLAMA_BASE_URL) を設定すると両環境のフォールバックになる
#   - どちらも未設定なら ENV に応じた既定値が使われる

# === 病院設定 ===
HOSPITAL=hanwa

# === チャンク分割 ===
# CHUNK_SIZE=130000
# CHUNK_OVERLAP=1000

# === Agentic Search ===
# MAX_SEARCH_ITERATIONS=3

# === Reflection ===
# MAX_REFLECTION_ITERATIONS=2

# === その他 ===
# HF_TOKEN=your-huggingface-token
